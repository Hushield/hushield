# SpamFilter server configuration
#
# Copy this file to `.env` (gitignored) and fill in real values for your
# environment. Never commit `.env` or real secrets.
#
# To generate a strong secret value for DEVICE_TOKEN_SECRET or ADMIN_TOKEN:
#   openssl rand -hex 32

# --- Database -----------------------------------------------------------

# MySQL DSN (go-sql-driver/mysql format). Must include parseTime=true and
# multiStatements=true (used by the migration runner).
DB_DSN=root@tcp(127.0.0.1:3306)/spamfilter_dev?parseTime=true&multiStatements=true

# --- HTTP server ----------------------------------------------------------

# Address the server listens on.
ADDR=:8080

# --- Admin routes ---------------------------------------------------------

# Bearer token required to access admin-only routes. Leave unset/empty to
# disable admin routes entirely (mock mode only).
# REQUIRED (non-empty) when ATTEST_MODE=apple.
ADMIN_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- App Attest / device tokens -------------------------------------------

# Selects the App Attest verifier: "mock" (default, dev/test, no real Apple
# verification) or "apple" (real Apple App Attest verification, production).
ATTEST_MODE=mock

# App Attest app identifier "<TeamID>.<BundleID>".
# REQUIRED when ATTEST_MODE=apple.
APP_ID=ABCDE12345.com.example.spamfilter

# HMAC secret used to sign stateless device tokens.
# REQUIRED (must be set to a strong, unique value) when ATTEST_MODE=apple —
# Load() refuses to start if this is unset or left at the insecure dev
# default in apple mode. Safe to leave unset in mock mode (a documented
# insecure dev default is used, with a startup warning).
DEVICE_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32

# How long an issued device token remains valid (Go duration string).
DEVICE_TOKEN_TTL=720h

# How long an issued attestation challenge remains valid (Go duration string).
CHALLENGE_TTL=5m

# --- Attestation challenge store ------------------------------------------

# Selects the ChallengeStore backend: "memory" (default, process-local; fine
# for a single instance) or "redis" (shared store, required for a
# multi-instance deployment).
CHALLENGE_STORE=memory

# Redis connection URL. REQUIRED when CHALLENGE_STORE=redis.
REDIS_URL=redis://localhost:6379/0

# --- APNs (silent push) ----------------------------------------------------

# All four APNS_* vars are optional as a group: when APNS_KEY_PATH is empty,
# silent-push is disabled and a no-op notifier is used (fail-safe). Set all
# four together to enable push.

# Filesystem path to the Apple token-based auth key (.p8, PKCS8 EC private
# key). Keep this file out of version control.
APNS_KEY_PATH=/etc/apns/AuthKey_XXXXXXXXXX.p8

# Key ID of the APNs auth key.
APNS_KEY_ID=XXXXXXXXXX

# Apple Team ID used as the provider JWT issuer.
APNS_TEAM_ID=ABCDE12345

# App bundle id sent as the apns-topic header.
APNS_TOPIC=com.example.spamfilter
