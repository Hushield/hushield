#!/usr/bin/env bash
# .githooks/pre-push -- local pre-deploy test gate.
#
# Runs the full test suite (Go + iOS, via `make test`) before allowing a
# push to proceed. This is the client-side enforcement of "comprehensive
# testing automatically run before any deployment" -- no cloud CI is used.
#
# Install with: make hooks
# (sets git config core.hooksPath .githooks and chmod +x's this file)

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running full test suite (make test) before allowing push..."

if ! make test; then
	echo "" >&2
	echo "pre-push: BLOCKED -- test suite failed. Push aborted." >&2
	echo "Fix the failing tests, or in an emergency use 'git push --no-verify' to bypass this gate." >&2
	exit 1
fi

echo "pre-push: test suite passed -- proceeding with push."
