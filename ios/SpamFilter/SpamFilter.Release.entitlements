<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release entitlements.

  The only difference from SpamFilter.entitlements (used for Debug) is the App
  Attest environment. Builds distributed through TestFlight or the App Store
  attest against Apple's PRODUCTION App Attest service, so a Release build must
  declare `production` here. Leaving `development` in a distributed build
  produces attestations the production verifier will not accept, which surfaces
  as a generic verification failure rather than anything that points at the
  environment -- an expensive thing to debug on a device.

  Debug builds keep `development` so local device runs continue to work.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.brahy.hushield</string>
	</array>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
